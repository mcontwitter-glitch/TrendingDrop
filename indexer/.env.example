# Solana RPC (poll-mode fallback; also used when Geyser is unset)
RPC_URL=https://api.devnet.solana.com

# Yellowstone / Geyser gRPC (optional — when unset, indexer uses RPC poll mode)
GEYSER_ENDPOINT=

# Program IDs (defaults match Anchor.toml / ARCHITECTURE.md)
NARRATIVE_AUCTION_PROGRAM_ID=75xWzXGb3A7UgpqDDL9ByVXpaZ8Zw4AF4i7whnVXyh8m
VELOCITY_CURVE_PROGRAM_ID=5VbDjccBDNVCPLpSgxyuw7ptYekrcxH8FySBxaAXx6C
LORE_MERGE_PROGRAM_ID=8pSr3X9iP66rvqMWT4S2gsEGtS8VnCLZtJayY9NB9ySy
REPUTATION_NFT_PROGRAM_ID=DrzQKZpvg8y7Gymp5yz2upX24v3fV7j7eFuqT31Nxgvd

# SQLite (default) or Postgres URL for future
DATABASE_URL=sqlite:./data/indexer.db

# Poll interval for RPC fallback mode (ms)
POLL_INTERVAL_MS=15000

# HTTP API
PORT=8787
HOST=0.0.0.0
