# Bonding Curve Casino — frontend (Vite)
# Copy to `.env` (gitignored) and adjust per cluster.
# Defaults below match Anchor.toml [programs.localnet].

# Solana HTTP RPC (local validator default)
VITE_SOLANA_RPC_URL=http://127.0.0.1:8899

# Program IDs (localnet / current declare_id! values)
VITE_NARRATIVE_AUCTION_PROGRAM_ID=75xWzXGb3A7UgpqDDL9ByVXpaZ8Zw4AF4i7whnVXyh8m
VITE_VELOCITY_CURVE_PROGRAM_ID=5VbDjccBDNVCPLpSgxyuw7ptYekrcxH8FySBxaAXx6C
VITE_LORE_MERGE_PROGRAM_ID=8pSr3X9iP66rvqMWT4S2gsEGtS8VnCLZtJayY9NB9ySy
VITE_REPUTATION_NFT_PROGRAM_ID=DrzQKZpvg8y7Gymp5yz2upX24v3fV7j7eFuqT31Nxgvd

# Optional Story Markets indexer HTTP API (see indexer/README.md)
# Leave unset to use mock / on-chain fallbacks in the UI.
VITE_INDEXER_URL=http://localhost:8787

# Optional L2 mirror display (cross-chain scaffold — see docs/CROSS_CHAIN.md)
# VITE_BASE_MIRROR_URL=
# VITE_ARBITRUM_MIRROR_URL=
